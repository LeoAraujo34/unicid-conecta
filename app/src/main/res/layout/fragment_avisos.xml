<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avisos Académicos"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:text="• Manutenção programada nos servidores de rede e laboratórios neste domingo.\n\n• Prazo final para solicitação de abono de faltas encerra na próxima sexta-feira.\n\n• Evento de tecnologia UNICID Conecta agendado para o auditório principal."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>