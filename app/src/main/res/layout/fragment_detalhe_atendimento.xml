<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/header_bg_atendimento"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@color/blue_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_sub_atendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="UNICID - OPERAÇÕES"
            android:textColor="#B0D0FF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title_atendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atendimento #01584"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_sub_atendimento"
            app:layout_constraintTop_toBottomOf="@id/tv_sub_atendimento" />

        <TextView
            android:id="@+id/tv_prioridade_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="PRIORIDADE MÉDIA"
            android:textColor="@color/badge_orange_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bg_atendimento" />

        <TextView
            android:id="@+id/tv_hora_ticket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Hoje, 14:32"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_prioridade_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_prioridade_badge" />

        <TextView
            android:id="@+id/tv_problema_atendimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:text="Computador sem internet"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_prioridade_badge" />

        <TextView
            android:id="@+id/tv_desc_atendimento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:text="Computador 12 está sem acesso à internet. Outros equipamentos estão funcionando normalmente."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_problema_atendimento" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_imagem_atendimento"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#E2E8F0"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_desc_atendimento">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Foto enviada pelo aluno"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:id="@+id/grid_detalhes_atendimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/card_imagem_atendimento">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="20dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_detalhe_local" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laboratório 204" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="20dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOLICITANTE" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_detalhe_solicitante" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Victor Hugo" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIA" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_detalhe_categoria" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tecnologia" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESPONSÁVEL" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_detalhe_responsavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carlos Mendes" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:id="@+id/tv_lbl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Alterar status"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/grid_detalhes_atendimento" />

        <LinearLayout
            android:id="@+id/layout_status_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_status">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_status_recebido"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Recebido"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_status_analise"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Em análise"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_status_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/layout_status_row1">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_status_manutencao"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Em manutenção"
                android:textAllCaps="false"
                android:textColor="@color/blue_primary"
                app:backgroundTint="@color/blue_light_bg"
                app:strokeColor="@color/blue_primary"
                app:strokeWidth="2dp"
                app:cornerRadius="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_status_resolvido"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Resolvido"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lbl_atualizacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Adicionar atualização"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_status_row2" />

        <EditText
            android:id="@+id/et_nota_manutencao"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="@color/white"
            android:gravity="top|start"
            android:hint="Descreva o que foi feito..."
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_lbl_atualizacao" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publicar_att"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:text="Publicar atualização"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/blue_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_nota_manutencao" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>